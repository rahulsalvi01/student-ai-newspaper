# Copy to .env.local for local development. Use fake placeholders here only.
# Never commit .env.local or real keys.

NEXT_PUBLIC_APP_NAME="My Daily Newspaper"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Supabase project settings (server/public values as appropriate).
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="YOUR_PUBLIC_ANON_KEY"
SUPABASE_SERVICE_ROLE_KEY="SET_SERVER_ONLY_IF_NEEDED"

# Protect the generation endpoint. Generate a long random secret.
GENERATION_SECRET="REPLACE_WITH_LONG_RANDOM_SECRET"

# Gmail delivery for the daily edition (configure secrets in GitHub Actions and server only).
# Use your Gmail address as both sender and recipient unless you intentionally separate them.
EMAIL_ENABLED="false"
GMAIL_ADDRESS=""
GMAIL_APP_PASSWORD=""
NEWSPAPER_RECIPIENT_EMAIL=""

# Optional AI summarisation; leave disabled for no-paid-AI baseline.
AI_SUMMARIES_ENABLED="false"
AI_PROVIDER=""
AI_API_KEY=""
AI_MODEL=""

# Optional operational settings.
DEFAULT_TIMEZONE="Asia/Kolkata"
DAILY_GENERATION_CRON="30 2 * * *"
MAX_ARTICLES_PER_SOURCE="100"
FEED_TIMEOUT_MS="10000"
